#!/bin/bash
# 맥 본체 긴 판 — 더블클릭 한 번(scripts/mac-long-run/판.command 를 ~/Mini/<카드>_판.command 로 베껴 둔다 · 카드 = 파일 이름의 첫 '_' 앞).
# 처음: 판 코드를 풀고(npm ci) 판목록의 판을 뒤에서 띄운다 — 창을 닫아도 판은 돈다. 다시 열면 진행을 보이고, 멈춘 판은 마지막 체크포인트에서 이어 띄운다.
C="$(basename "$0")"; C="${C%%_*}"
echo "$C — 맥은 전원에 꽂고 뚜껑을 열어 두십시오(덮으면 잠들어 판이 멈춥니다 · 다시 열면 이어 돕니다)."
bash "$(dirname "$0")/_runs/$C/판.sh" "$(dirname "$0")/_runs/$C/판목록.txt"
echo
read -r -p "엔터를 누르면 창을 닫습니다(판은 뒤에서 계속 돕니다) "
